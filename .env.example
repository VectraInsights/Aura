# ===== IA (Gemini - camada gratuita do Google AI Studio) =====
# Este arquivo é só para uso LOCAL. Na Vercel a mesma chave vai em
# Settings -> Environment Variables (ver README).
# Pegue a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos confirmados respondendo na free tier (testados em 21/10/2026):
#   gemini-3.6-flash | gemini-3.5-flash | gemini-3.5-flash-lite | gemini-3-flash-preview
# Os 2.5/2.0 foram descontinuados para contas novas; os Pro dão 429 na free tier.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELOS_FALLBACK=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview
GEMINI_TEMPERATURE=0.2

# ===== Cache local (evita re-scraping / re-rate-limit) =====
CACHE_DIR=.cache
CACHE_TTL_HORAS=12

# ===== limites =====
MAX_TICKERS_ANALISE=8
