# ===== IA (Gemini - camada gratuita do Google AI Studio) =====
# Este arquivo é só para uso LOCAL. Na Vercel a mesma chave vai em
# Settings -> Environment Variables (ver README).
# Pegue a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos confirmados respondendo na free tier (testados em 21/10/2026):
#   gemini-3.6-flash | gemini-3.5-flash | gemini-3.5-flash-lite | gemini-3-flash-preview
# Os 2.5/2.0 foram descontinuados para contas novas; os Pro dão 429 na free tier.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELOS_FALLBACK=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview
GEMINI_TEMPERATURE=0.2

# ===== Login (opcional) =====
# Deixe vazio para a aplicacao ficar aberta. Com senha, todas as rotas de
# dados exigem sessao (cookie assinado).
APP_PASSWORD=
# Chave de assinatura do cookie de sessao. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_AGE=604800

# ===== Monitor de regras (canais de aviso) =====
# Telegram (bot criado em @BotFather):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp - modo 1: CallMeBot (gratis, sem cadastro de empresa).
# Envie /start para o bot +55 (11) 99999-9999 uma vez e pegue a apikey em
# https://www.callmebot.com/whatsapp.php
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# WhatsApp - modo 2: Meta Cloud API (WhatsApp Business, com template aprovado).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=aura_alerta
# Numero que recebe (formato internacional, so digitos). Tambem usado para
# gerar o link wa.me que acompanha os alertas de outros canais.
WHATSAPP_DESTINO=

# Webhook generico (n8n, Make, Discord, Slack, qualquer HTTP que aceite POST):
WEBHOOK_URL=

# ===== Onde ficam as regras e o historico =====
REGRAS_ARQUIVO=data/regras.json
HISTORICO_ALERTAS=data/alertas.jsonl

# Opcional: Upstash Redis (REST) para as regras ficarem num lugar compartilhado
# entre a Vercel e o monitor. Sem isso, valem as variaveis acima.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Cache local (evita re-scraping / re-rate-limit) =====
CACHE_DIR=.cache
CACHE_TTL_HORAS=12

# ===== limites =====
MAX_TICKERS_ANALISE=8
