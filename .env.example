# ===== IA (Gemini - camada gratuita do Google AI Studio) =====
# Pegue a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos com cota gratuita: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# ===== Cache local (evita re-scraping / re-rate-limit) =====
CACHE_DIR=.cache
CACHE_TTL_HORAS=12

# ===== universo / limites =====
MAX_TICKERS_ANALISE=10
